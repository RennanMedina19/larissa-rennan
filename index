  function closeLightbox(){ lightbox.classList.remove('open'); }
  slides.forEach((slide, i)=> slide.addEventListener('click', ()=> openLightbox(i)));
  document.getElementById('lbClose').addEventListener('click', closeLightbox);
  document.getElementById('lbPrev').addEventListener('click', ()=> openLightbox((lbIndex-1+slides.length)%slides.length));
  document.getElementById('lbNext').addEventListener('click', ()=> openLightbox((lbIndex+1)%slides.length));
