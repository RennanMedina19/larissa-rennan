<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Larissa & Rennan — 08.10.2028</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --tiffany:#6FE0D4;
    --tiffany-deep:#22B0A2;
    --tiffany-light:#EAFBF8;
    --tiffany-mid:#CFF5F0;
    --paper:#FFFFFF;
    --ink:#1C2A28;
    --ink-soft:#72827F;
    --line: rgba(28,42,40,0.10);
    --shadow: 0 20px 50px -25px rgba(34,176,162,0.35);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter', sans-serif;
    font-weight:300;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3,.display{
    font-family:'Fraunces', serif;
    font-weight:500;
    letter-spacing:-0.01em;
    margin:0;
  }
  .eyebrow{
    font-family:'Inter', sans-serif;
    text-transform:uppercase;
    letter-spacing:.28em;
    font-size:.66rem;
    color:var(--tiffany-deep);
    font-weight:500;
  }
  a{color:inherit;}
  img{max-width:100%;display:block;}
  button{font-family:'Inter',sans-serif;}

  /* reveal on scroll */
  .reveal{ opacity:0; transform:translateY(28px); transition:opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1); }
  .reveal.in{ opacity:1; transform:translateY(0); }

  /* ---------- NAV ---------- */
  nav{
    position:fixed; top:0; left:0; right:0; z-index:100;
    display:flex; align-items:center; justify-content:space-between;
    gap:16px;
    padding:18px clamp(20px,4vw,56px);
    background:rgba(255,255,255,0.72);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
    font-size:.72rem;
    transition:.3s;
  }
  .nav-mark{ font-family:'Fraunces',serif; font-weight:600; font-size:1.15rem; }
  .nav-mark .amp{ color:var(--tiffany-deep); font-style:italic; }
  .nav-links{
    display:flex; gap:clamp(12px,2.4vw,32px);
    letter-spacing:.1em; text-transform:uppercase;
    overflow-x:auto; white-space:nowrap;
  }
  .nav-links a{
    text-decoration:none; color:var(--ink-soft);
    padding-bottom:3px; border-bottom:1px solid transparent;
    transition:.3s;
  }
  .nav-links a:hover, .nav-links a:focus-visible{ color:var(--tiffany-deep); border-color:var(--tiffany); }

  section{
    padding:clamp(80px,11vw,140px) clamp(20px,5vw,56px);
    position:relative;
    max-width:1160px;
    margin:0 auto;
  }
  .tint{ background:var(--tiffany-light); max-width:none; }
  .tint .inner{ max-width:1160px; margin:0 auto; }

  /* ---------- HERO ---------- */
  .hero{
    min-height:100vh;
    display:flex; flex-direction:column;
    justify-content:center;
    padding:150px clamp(20px,6vw,72px) 90px;
    max-width:none;
    background:
      radial-gradient(60% 50% at 15% 10%, var(--tiffany-mid) 0%, transparent 60%),
      radial-gradient(50% 45% at 90% 20%, var(--tiffany-light) 0%, transparent 55%),
      linear-gradient(180deg, #ffffff 0%, #ffffff 100%);
    position:relative;
    overflow:hidden;
  }
  .blob{
    position:absolute; border-radius:50%;
    background:linear-gradient(135deg, var(--tiffany), var(--tiffany-mid));
    filter:blur(60px); opacity:.5; z-index:0;
    animation:float 12s ease-in-out infinite;
  }
  .blob.b1{ width:340px; height:340px; top:-80px; left:-100px; }
  .blob.b2{ width:260px; height:260px; bottom:-60px; right:-60px; animation-delay:-4s; }
  @keyframes float{ 0%,100%{ transform:translate(0,0) scale(1);} 50%{ transform:translate(20px,-24px) scale(1.06);} }

  .hero-inner{
    position:relative; z-index:1;
    display:grid; grid-template-columns:.85fr 1.15fr; gap:clamp(32px,6vw,72px);
    align-items:center; max-width:1160px; margin:0 auto; width:100%;
  }
  @media (max-width:860px){
    .hero-inner{ grid-template-columns:1fr; text-align:center; }
    .hero-photo-wrap{ order:-1; margin:0 auto; }
  }
  .hero-photo-wrap{ position:relative; width:100%; max-width:420px; justify-self:center; }
  .hero-photo-glow{
    position:absolute; inset:-18px;
    background:linear-gradient(135deg, var(--tiffany), var(--tiffany-mid));
    border-radius:44% 56% 62% 38% / 48% 42% 58% 52%;
    filter:blur(2px); opacity:.55; z-index:0;
    animation:morph 10s ease-in-out infinite;
  }
  @keyframes morph{
    0%,100%{ border-radius:44% 56% 62% 38% / 48% 42% 58% 52%; }
    50%{ border-radius:58% 42% 40% 60% / 55% 60% 40% 45%; }
  }
  .hero-photo{
    position:relative; z-index:1;
    width:100%; aspect-ratio:4/5; object-fit:cover;
    border-radius:38% 62% 60% 40% / 46% 40% 60% 54%;
    box-shadow:0 30px 60px -25px rgba(34,176,162,0.45);
    border:6px solid #fff;
    animation:morph 10s ease-in-out infinite;
  }
  .hero-text{ position:relative; z-index:1; }
  .rings{ width:56px; height:36px; margin-bottom:18px; }
  .hero h1{
    font-size:clamp(2.8rem, 7.4vw, 5.6rem);
    line-height:.98;
    font-style:italic;
    font-weight:500;
  }
  .hero h1 .and{ color:var(--tiffany-deep); font-family:'Fraunces',serif; }
  .hero .subtitle{
    margin-top:20px; font-size:1.05rem; color:var(--ink-soft); letter-spacing:.04em;
  }
  .countdown{
    margin-top:52px; display:flex; gap:clamp(14px,3vw,28px); flex-wrap:wrap;
  }
  @media (max-width:860px){ .countdown{ justify-content:center; } }
  .countdown .unit{
    text-align:center; min-width:74px; background:#fff;
    border:1px solid var(--line); border-radius:16px; padding:16px 10px;
    box-shadow:var(--shadow);
    transition:.3s;
  }
  .countdown .unit:hover{ transform:translateY(-4px); }
  .countdown .num{ font-family:'Fraunces',serif; font-weight:600; font-size:clamp(1.7rem,4vw,2.3rem); color:var(--tiffany-deep); line-height:1; }
  .countdown .lbl{ display:block; margin-top:6px; font-size:.6rem; letter-spacing:.18em; text-transform:uppercase; color:var(--ink-soft); }
  .scroll-hint{
    position:absolute; bottom:28px; left:50%; transform:translateX(-50%);
    font-size:.64rem; letter-spacing:.28em; text-transform:uppercase; color:var(--ink-soft);
    animation:bob 2.4s ease-in-out infinite; z-index:1;
  }
  @keyframes bob{ 0%,100%{transform:translate(-50%,0);} 50%{transform:translate(-50%,8px);} }

  /* ---------- SECTION HEAD ---------- */
  .section-head{ text-align:center; margin-bottom:56px; max-width:620px; margin-left:auto; margin-right:auto; }
  .section-head h2{ font-size:clamp(2.1rem,4.6vw,2.9rem); margin-top:10px; font-style:italic; }
  .section-head p{ color:var(--ink-soft); line-height:1.7; margin-top:14px; }

  /* ---------- CARROSSEL ---------- */
  .carousel{ position:relative; }
  .carousel-track-wrap{ overflow:hidden; border-radius:20px; }
  .carousel-track{ display:flex; transition:transform .55s cubic-bezier(.2,.7,.2,1); }
  .slide{
    min-width:100%; aspect-ratio:16/9;
    display:flex; align-items:center; justify-content:center; gap:12px; flex-direction:column;
    background:
      repeating-linear-gradient(135deg, var(--tiffany-mid) 0 2px, transparent 2px 16px),
      linear-gradient(160deg, #ffffff, var(--tiffany-light));
    color:var(--tiffany-deep); cursor:pointer;
    transition:.3s;
  }
  .slide:hover{ background:linear-gradient(160deg, var(--tiffany-mid), var(--tiffany-light)); }
  .slide svg{ width:40px; height:40px; opacity:.8; }
  .slide span{ font-size:.72rem; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-soft); }
  .carousel-btn{
    position:absolute; top:50%; transform:translateY(-50%);
    width:44px; height:44px; border-radius:50%; border:none; cursor:pointer;
    background:#fff; color:var(--tiffany-deep); box-shadow:var(--shadow);
    display:flex; align-items:center; justify-content:center;
    transition:.25s; z-index:2;
  }
  .carousel-btn:hover{ background:var(--tiffany-deep); color:#fff; }
  .carousel-btn.prev{ left:-8px; } .carousel-btn.next{ right:-8px; }
  @media (max-width:640px){ .carousel-btn.prev{ left:6px;} .carousel-btn.next{ right:6px;} }
  .dots{ display:flex; gap:8px; justify-content:center; margin-top:20px; }
  .dot{ width:8px; height:8px; border-radius:50%; background:var(--line); border:none; cursor:pointer; transition:.3s; padding:0; }
  .dot.active{ background:var(--tiffany-deep); width:22px; border-radius:5px; }

  /* lightbox */
  .lightbox{
    position:fixed; inset:0; background:rgba(20,32,30,0.92); z-index:300;
    display:flex; align-items:center; justify-content:center;
    opacity:0; pointer-events:none; transition:opacity .3s;
  }
  .lightbox.open{ opacity:1; pointer-events:all; }
  .lightbox-content{
    width:min(760px,90vw); aspect-ratio:16/9; border-radius:16px;
    background:linear-gradient(160deg, var(--tiffany-mid), var(--tiffany-light));
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px;
    color:var(--tiffany-deep); transform:scale(.92); transition:.35s;
  }
  .lightbox.open .lightbox-content{ transform:scale(1); }
  .lightbox-content svg{ width:52px; height:52px; opacity:.85; }
  .lightbox-close, .lightbox-nav{
    position:absolute; background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.3); color:#fff;
    border-radius:50%; width:44px; height:44px; cursor:pointer; display:flex; align-items:center; justify-content:center;
    transition:.25s;
  }
  .lightbox-close:hover, .lightbox-nav:hover{ background:var(--tiffany); color:var(--ink); }
  .lightbox-close{ top:26px; right:26px; }
  .lightbox-nav.prev{ left:26px; top:50%; transform:translateY(-50%); }
  .lightbox-nav.next{ right:26px; top:50%; transform:translateY(-50%); }
  @media (max-width:640px){ .lightbox-nav.prev{left:10px;} .lightbox-nav.next{right:10px;} .lightbox-close{top:14px;right:14px;} }

  /* ---------- DEPOIMENTOS ---------- */
  .testi-wrap{ display:grid; grid-template-columns:1fr 1.1fr; gap:44px; align-items:flex-start; }
  @media (max-width:800px){ .testi-wrap{ grid-template-columns:1fr; } }
  .testi-form{
    background:#fff; border:1px solid var(--line); border-radius:20px;
    padding:36px; box-shadow:var(--shadow);
  }
  .testi-form label{ display:block; font-size:.66rem; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:8px; }
  .testi-form input, .testi-form textarea{
    width:100%; padding:13px 16px; margin-bottom:22px;
    border:1px solid var(--line); border-radius:12px;
    background:var(--tiffany-light);
    font-family:'Inter',sans-serif; font-size:.95rem; color:var(--ink); resize:vertical;
    transition:.25s;
  }
  .testi-form input:focus, .testi-form textarea:focus{ outline:none; border-color:var(--tiffany-deep); background:#fff; box-shadow:0 0 0 4px var(--tiffany-mid); }
  .btn{
    appearance:none; border:none; cursor:pointer;
    background:linear-gradient(135deg, var(--tiffany-deep), var(--tiffany)); color:#fff;
    padding:14px 30px; border-radius:100px;
    font-size:.75rem; letter-spacing:.16em; text-transform:uppercase; font-weight:500;
    transition:.3s; box-shadow:0 12px 26px -14px rgba(34,176,162,0.6);
  }
  .btn:hover, .btn:focus-visible{ transform:translateY(-2px); box-shadow:0 16px 30px -12px rgba(34,176,162,0.7); }
  .btn:focus-visible{ outline:2px solid var(--ink); outline-offset:2px; }

  .testi-list{ display:flex; flex-direction:column; gap:16px; max-height:520px; overflow:auto; padding-right:4px; }
  .testi-card{
    background:#fff; border:1px solid var(--line); border-left:3px solid var(--tiffany-deep);
    padding:20px 22px; border-radius:14px;
    animation:pop .4s cubic-bezier(.2,.8,.2,1);
  }
  @keyframes pop{ from{ opacity:0; transform:translateY(10px) scale(.98);} to{ opacity:1; transform:translateY(0) scale(1);} }
  .testi-card p{ margin:0 0 10px; font-style:italic; color:var(--ink); line-height:1.6; }
  .testi-card .who{ font-size:.7rem; letter-spacing:.1em; text-transform:uppercase; color:var(--tiffany-deep); }
  .testi-empty{ color:var(--ink-soft); font-size:.9rem; font-style:italic; }

  /* ---------- CARDAPIO ---------- */
  .menu-tabs{ display:flex; justify-content:center; gap:10px; flex-wrap:wrap; margin-bottom:36px; }
  .menu-tab{
    padding:10px 22px; border:1px solid var(--tiffany-deep); border-radius:100px;
    background:transparent; color:var(--tiffany-deep); cursor:pointer;
    font-size:.72rem; letter-spacing:.14em; text-transform:uppercase;
    transition:.3s;
  }
  .menu-tab.active, .menu-tab:hover{ background:var(--tiffany-deep); color:#fff; transform:translateY(-2px); }
  .menu-panel{ display:none; text-align:center; }
  .menu-panel.active{ display:block; animation:pop .4s cubic-bezier(.2,.8,.2,1); }
  .menu-placeholder{ border:1px dashed var(--tiffany); border-radius:16px; padding:52px 24px; color:var(--ink-soft); background:var(--tiffany-light); }
  .menu-placeholder .display{ font-size:1.5rem; color:var(--tiffany-deep); display:block; margin-bottom:8px; font-style:italic; }

  /* ---------- PRESENTES ---------- */
  .gifts-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:20px; margin-bottom:28px; }
  .gift-card{
    background:#fff; border:1px solid var(--line); border-radius:18px; padding:28px 24px; text-align:center;
    transition:.3s; box-shadow:0 14px 30px -22px rgba(28,42,40,0.25);
    animation:pop .45s cubic-bezier(.2,.8,.2,1);
  }
  .gift-card:hover{ transform:translateY(-6px); box-shadow:var(--shadow); }
  .gift-card svg{ width:30px;height:30px; margin-bottom:14px; color:var(--tiffany-deep); }
  .gift-card h3{ font-size:1.1rem; margin-bottom:6px; font-style:italic; line-height:1.3; min-height:2.6em; }
  .gift-card .price{ color:var(--tiffany-deep); font-weight:600; font-size:1.05rem; margin:0 0 18px; font-family:'Fraunces',serif; }
  .gift-card .btn{ background:transparent; color:var(--tiffany-deep); border:1px solid var(--tiffany-deep); box-shadow:none; padding:11px 24px; }
  .gift-card .btn:hover{ background:var(--tiffany-deep); color:#fff; }
  .load-more-wrap{ display:flex; justify-content:center; margin-bottom:52px; }
  .btn.on-light{ background:#fff; color:var(--tiffany-deep); border:1px solid var(--tiffany-deep); box-shadow:none; }
  .btn.on-light:hover{ background:var(--tiffany-deep); color:#fff; }
  .btn.on-light:disabled{ opacity:.45; cursor:default; transform:none; box-shadow:none; }

  .pix-box{
    background:linear-gradient(135deg, var(--tiffany-deep), var(--tiffany)); color:#fff;
    border-radius:24px; padding:48px; text-align:center;
  }
  .pix-box .eyebrow{ color:rgba(255,255,255,0.85); }
  .pix-box h3{ color:#fff; font-size:1.9rem; margin:10px 0 20px; font-style:italic; }
  .pix-key{
    display:inline-flex; align-items:center; gap:14px;
    background:rgba(255,255,255,0.14); border:1px solid rgba(255,255,255,0.35);
    padding:12px 20px; border-radius:100px; font-size:.9rem; flex-wrap:wrap; justify-content:center;
  }
  .pix-key button{
    appearance:none; border:none; cursor:pointer; background:#fff; color:var(--tiffany-deep);
    padding:9px 18px; border-radius:100px; font-size:.68rem; letter-spacing:.14em; text-transform:uppercase;
    transition:.25s;
  }
  .pix-key button:hover{ background:var(--ink); color:#fff; }
  .pix-note{ margin-top:16px; font-size:.78rem; color:rgba(255,255,255,0.85); }

  /* ---------- LOCALIZACAO ---------- */
  .loc-wrap{ display:grid; grid-template-columns:1fr 1fr; gap:32px; align-items:center; }
  @media (max-width:800px){ .loc-wrap{ grid-template-columns:1fr; } }
  .map-placeholder{
    aspect-ratio:4/3; border-radius:20px; border:1px solid var(--line);
    overflow:hidden; display:block; position:relative;
    transition:.3s; box-shadow:0 14px 30px -22px rgba(28,42,40,0.2);
  }
  .map-placeholder:hover{ transform:translateY(-4px); }
  .map-frame{ width:100%; height:100%; border:0; display:block; pointer-events:none; }
  .loc-info h3{ font-size:1.6rem; margin-bottom:14px; font-style:italic; }
  .loc-info p{ color:var(--ink-soft); line-height:1.8; }
  .loc-info .tbd{ display:inline-block; margin-top:18px; padding:9px 18px; border:1px dashed var(--tiffany); border-radius:100px; font-size:.72rem; letter-spacing:.1em; text-transform:uppercase; color:var(--tiffany-deep); }

  footer{ text-align:center; padding:70px 24px 50px; color:var(--ink-soft); font-size:.8rem; background:var(--tiffany-light); max-width:none; }
  footer .fmark{ font-family:'Fraunces',serif; font-style:italic; font-size:1.9rem; margin-bottom:14px; color:var(--tiffany-deep); }

  .toast{
    position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px);
    background:var(--ink); color:#fff; padding:12px 22px; border-radius:100px;
    font-size:.78rem; letter-spacing:.05em; opacity:0; pointer-events:none; transition:.35s; z-index:400;
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
</style>
</head>
<body>

<nav>
  <span class="nav-mark">Larissa <span class="amp">&amp;</span> Rennan</span>
  <div class="nav-links">
    <a href="#galeria">Galeria</a>
    <a href="#depoimentos">Depoimentos</a>
    <a href="#cardapio">Cardápio</a>
    <a href="#presentes">Presentes</a>
    <a href="#local">Localização</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero" id="inicio">
  <div class="blob b1"></div>
  <div class="blob b2"></div>
  <div class="hero-inner">
    <div class="hero-photo-wrap">
      <div class="hero-photo-glow"></div>
      <img class="hero-photo" src="data:image/jpeg;base64," alt="Larissa e Rennan">
    </div>
    <div class="hero-text">
      <svg class="rings" viewBox="0 0 64 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="24" cy="20" r="14" stroke="#22B0A2" stroke-width="1.6"/>
        <circle cx="40" cy="20" r="14" stroke="#22B0A2" stroke-width="1.6" stroke-opacity="0.45"/>
      </svg>
      <span class="eyebrow">Estamos nos casando</span>
      <h1>Larissa <span class="and">&amp;</span> Rennan</h1>
      <p class="subtitle">08 de outubro de 2028</p>
      <div class="countdown" id="countdown">
        <div class="unit"><div class="num" id="cd-dias">--</div><span class="lbl">Dias</span></div>
        <div class="unit"><div class="num" id="cd-horas">--</div><span class="lbl">Horas</span></div>
        <div class="unit"><div class="num" id="cd-min">--</div><span class="lbl">Min</span></div>
        <div class="unit"><div class="num" id="cd-seg">--</div><span class="lbl">Seg</span></div>
      </div>
    </div>
  </div>
  <div class="scroll-hint">Deslize para ver mais</div>
</section>

<!-- GALERIA / CARROSSEL -->
<section id="galeria">
  <div class="section-head reveal">
    <span class="eyebrow">Nossos momentos</span>
    <h2>Galeria</h2>
    <p>Em breve, os registros mais especiais da nossa história vão preencher este espaço. Clique em uma foto para abrir em tela cheia.</p>
  </div>
  <div class="carousel reveal">
    <div class="carousel-track-wrap">
      <div class="carousel-track" id="track">
        <div class="slide" data-index="0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3" y="4" width="18" height="16" rx="1.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M21 16l-5.5-5.5L9 17"/></svg><span>Foto 1 — em breve</span></div>
        <div class="slide" data-index="1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3" y="4" width="18" height="16" rx="1.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M21 16l-5.5-5.5L9 17"/></svg><span>Foto 2 — em breve</span></div>
        <div class="slide" data-index="2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3" y="4" width="18" height="16" rx="1.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M21 16l-5.5-5.5L9 17"/></svg><span>Foto 3 — em breve</span></div>
        <div class="slide" data-index="3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3" y="4" width="18" height="16" rx="1.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M21 16l-5.5-5.5L9 17"/></svg><span>Foto 4 — em breve</span></div>
        <div class="slide" data-index="4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3" y="4" width="18" height="16" rx="1.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M21 16l-5.5-5.5L9 17"/></svg><span>Foto 5 — em breve</span></div>
      </div>
    </div>
